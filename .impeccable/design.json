  "narrative": {
    "northStar": "The Launch Page",
    "overview": "A parent skims a free class the way they skim a product launch: a white page, one confident headline, one blue action, and a single scroll-driven demo that shows what a kid actually does. References: apple.com, stripe.com, linear.app. Low density, generous rhythm; neutrals plus one blue and exactly one dark band. Depth comes from soft layered shadows and a few glass surfaces.",
    "keyCharacteristics": [
      "White (paper) and mist surfaces, ink text, one blue accent; one night band.",
      "Geist at 600-650 with negative tracking; Geist Mono only for code.",
      "Big radii (20-28px), pill buttons, soft multi-layer shadows.",
      "One authored motion moment; everything else is a quiet opacity-and-rise.",
      "One primary action on the whole site."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Launch Blue marks action and focus. It never decorates.",
        "section": "colors"
      },
      {
        "name": "The Hue Is A Mark Rule",
        "body": "Category hues are never text on white; they are dots, icon fills and gradients.",
        "section": "colors"
      },
      {
        "name": "The One Night Rule",
        "body": "Exactly one dark band per page; the rest is light.",
        "section": "colors"
      },
      {
        "name": "The Tight Tracking Rule",
        "body": "Headings track negative (-0.025em to -0.045em); the bigger the size, the tighter.",
        "section": "typography"
      },
      {
        "name": "The Mono Is Code Rule",
        "body": "Geist Mono appears only where source code is shown.",
        "section": "typography"
      },
      {
        "name": "The Glass Is Rare Rule",
        "body": "Glass is for the sticky nav and the floating course chips only. Content cards are solid.",
        "section": "elevation"
      },
      {
        "name": "The Static Blur Rule",
        "body": "Blur lives on static surfaces. Never animate a filter or backdrop-filter.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use EmailCta for the single primary action, with its fixed copy.",
      "Do use container-x, section-y and the t-* utilities rather than ad hoc sizes.",
      "Do read category colours from content/courses.ts.",
      "Do use mist for secondary surfaces and hairlines for dividers.",
      "Do add new motion as transform/opacity with a reduced-motion fallback that shows the final state."
    ],
    "donts": [
      "Don't add a second primary button, or reword \"Get class dates by email\".",
      "Don't use category hues as text on white.",
      "Don't animate blur, filter or backdrop-filter; don't put glass on content cards.",
      "Don't hide unrevealed content with visibility: hidden or display: none.",
      "Don't replace the sticky story with a GSAP pin (CLS).",
      "Don't invent numbers, testimonials or full names of minors."
    ]
  }
